# =====================================================================
# HOMES2OWN — Mumbai Real Estate Consultancy Platform
# Environment Variables Configuration Template
# =====================================================================

# Server & Runtime Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
APP_DOMAIN=homes2own.com

# Database Connection (MySQL 8.0)
# Note: If local MySQL is offline or not installed, backend automatically
# initialises the embedded SQLite zero-setup database engine.
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=homes2own_user
DB_PASSWORD=homes2own_secure_pass
DB_NAME=homes2own_db

# Security & JSON Web Tokens
JWT_SECRET=homes2own_jwt_secret_mumbai_advisory_2026_super_key
JWT_EXPIRES_IN=7d

# API Rate Limiting (15 minutes window, max requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Advisory Contact Channels
WHATSAPP_PHONE=919664586316
CONSULTANT_EMAIL=advisory@homes2own.com
OFFICE_PHONE=+919664586316
