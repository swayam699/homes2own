# =====================================================================
# Online Food Ordering System - Global Environment Variables Template
# =====================================================================

PORT=5000
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET=super_secret_food_ordering_jwt_key_2026_prod
JWT_EXPIRES_IN=7d

# Database Connection (MySQL 8.0)
# Note: If local MySQL password is empty or not configured, the app gracefully
# activates the embedded zero-downtime SQLite engine for instantaneous running.
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=food_ordering_db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
