PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=super_secret_food_ordering_jwt_key_2026_prod
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL)
# If MySQL is not running or credentials are not yet configured,
# the backend gracefully falls back to embedded SQLite for zero-downtime demo/testing.
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=food_ordering_db

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
